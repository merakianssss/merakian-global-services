# Merakian Global Website — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ─── Email (Resend) ───────────────────────────────────────────────
# Get your API key at: https://resend.com/api-keys
# Free tier: 100 emails/day, 5,000 emails/month
RESEND_API_KEY=

# The email address that receives enquiries (business inbox)
# Default: kapil.songara@merakian.net (used if not set)
CONTACT_TO_EMAIL=kapil.songara@merakian.net

# The "From" address shown in emails.
# Must be a domain you've verified in Resend.
# Default: Merakian Global <enquiries@merakian.net>
FROM_EMAIL=Merakian Global <enquiries@merakian.net>

# ─── Spam Protection (Cloudflare Turnstile) — Optional ─────────────
# Get site/secret keys at: https://dash.cloudflare.com/turnstile
# Leave blank to skip Turnstile verification.
# RECOMMENDED: Set up free Turnstile for better spam protection.
#
# PUBLIC_TURNSTILE_SITE_KEY: Used CLIENT-SIDE (browser). Safe to expose.
#   Prefix with PUBLIC_ per Astro convention (Vite replaces it at build time).
#   Set in Netlify: Site Settings → Environment Variables → Variables tab.
PUBLIC_TURNSTILE_SITE_KEY=
#
# TURNSTILE_SECRET_KEY: Used SERVER-SIDE only (Netlify Function). Never exposed.
#   Set in Netlify: Site Settings → Environment Variables → Variables tab.
TURNSTILE_SECRET_KEY=

# ─── Security (optional overrides) ───────────────────────────────
# Allowed origins for cross-origin requests to the enquiry function.
# Default includes production domain + localhost dev ports.
# Separate multiple origins with commas.
# ALLOWED_ORIGINS=https://merakian.net,http://localhost:4321

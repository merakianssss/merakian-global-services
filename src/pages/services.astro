---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';

const travelServices = [
  {
    icon: 'travel_explore',
    title: 'Travel & Ticketing',
    description: 'Comprehensive global transit solutions across all major modes.',
  },
  {
    icon: 'flight_takeoff',
    title: 'Air Ticketing',
    description: 'Premium air travel reservations for domestic and international destinations.',
  },
  {
    icon: 'train',
    title: 'Bus & Rail Ticketing',
    description: 'Efficient ground transportation networking and ticketing services.',
  },
  {
    icon: 'directions_boat',
    title: 'Ship / Other Transport Ticketing',
    description: 'Marine and alternative transportation booking assistance.',
  },
  {
    icon: 'map',
    title: 'Travel & Tour Consultation',
    description: 'Customized itinerary planning and destination consultancy.',
  },
];

const careerServices = [
  {
    icon: 'work',
    title: 'Domestic Career Consultation',
    description: 'Strategic career mapping and placement for national opportunities.',
  },
  {
    icon: 'public',
    title: 'International Career Consultation',
    description: 'Guidance and placement services for global career advancements.',
  },
];

const manpowerServices = [
  {
    icon: 'groups',
    title: 'Manpower Supply',
    description: 'Elite workforce provision tailored to specific corporate needs.',
  },
  {
    icon: 'person_search',
    title: 'Recruitment & Headhunting',
    description: 'Targeted search for executive and specialized talent globally.',
  },
  {
    icon: 'how_to_reg',
    title: 'Candidate Screening',
    description: 'Thorough background and skills verification processes.',
  },
  {
    icon: 'model_training',
    title: 'Interview Preparation',
    description: 'Expert coaching to ensure candidates present their best selves.',
  },
];

const courierServices = [
  {
    icon: 'inventory_2',
    title: 'Courier Consolidation',
    description: 'Efficient package grouping to optimize shipping costs and timelines.',
  },
  {
    icon: 'local_shipping',
    title: 'Domestic Courier Support',
    description: 'Reliable logistics assistance for nationwide deliveries.',
  },
  {
    icon: 'flight',
    title: 'International Courier Support',
    description: 'Secure and swift international shipping facilitation.',
  },
];
---

<PageLayout
  title="Merakian Global - Services"
  description="Comprehensive travel, logistics, and career consultancy services tailored for the ambitious global citizen."
>
  <Hero
    title="Global Expertise, Seamless Journeys"
    subtitle="Comprehensive travel, logistics, and career consultancy tailored for the ambitious global citizen."
    backgroundImage="/images/hero-home.jpg"
  />

  <div class="flight-path max-w-container mx-auto opacity-50 my-stack-lg"></div>

  <section class="max-w-container mx-auto px-6 md:px-margin-mobile lg:px-margin-desktop mb-stack-xl">
    <!-- Travel Section -->
    <div class="mb-16">
      <h2 class="font-libre-caslon text-headline-lg text-primary mb-8 border-b border-primary/20 pb-4">
        Travel & Ticketing Solutions
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
        {travelServices.map((service) => (
          <a href="/contact" class="group bg-charcoal-surface border border-white/10 hover:border-primary transition-all duration-500 rounded-lg p-8 relative overflow-hidden flex flex-col h-full">
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-bl-full -mr-16 -mt-16 transition-transform group-hover:scale-150 duration-700"></div>
            <div class="mb-6 inline-flex items-center justify-center w-12 h-12 rounded-full bg-primary/10 text-primary border border-primary/20">
              <span class="material-symbols-outlined">{service.icon}</span>
            </div>
            <h3 class="font-libre-caslon text-headline-md text-on-surface mb-4 group-hover:text-primary transition-colors">
              {service.title}
            </h3>
            <p class="text-body-md text-on-surface-variant flex-grow mb-6">
              {service.description}
            </p>
            <span class="mt-auto font-label-sm text-label-sm uppercase tracking-widest text-primary flex items-center gap-2 group-hover:gap-3 transition-all">
              Explore Service
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Careers Section -->
    <div class="mb-16">
      <h2 class="font-libre-caslon text-headline-lg text-primary mb-8 border-b border-primary/20 pb-4">
        Career Consultation
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
        {careerServices.map((service) => (
          <a href="/contact" class="group bg-charcoal-surface border border-white/10 hover:border-primary transition-all duration-500 rounded-lg p-8 relative overflow-hidden flex flex-col h-full">
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-bl-full -mr-16 -mt-16 transition-transform group-hover:scale-150 duration-700"></div>
            <div class="mb-6 inline-flex items-center justify-center w-12 h-12 rounded-full bg-primary/10 text-primary border border-primary/20">
              <span class="material-symbols-outlined">{service.icon}</span>
            </div>
            <h3 class="font-libre-caslon text-headline-md text-on-surface mb-4 group-hover:text-primary transition-colors">
              {service.title}
            </h3>
            <p class="text-body-md text-on-surface-variant flex-grow mb-6">
              {service.description}
            </p>
            <span class="mt-auto font-label-sm text-label-sm uppercase tracking-widest text-primary flex items-center gap-2 group-hover:gap-3 transition-all">
              Explore Service
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Manpower Section -->
    <div class="mb-16">
      <h2 class="font-libre-caslon text-headline-lg text-primary mb-8 border-b border-primary/20 pb-4">
        Manpower & Recruitment
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
        {manpowerServices.map((service) => (
          <a href="/contact" class="group bg-charcoal-surface border border-white/10 hover:border-primary transition-all duration-500 rounded-lg p-8 relative overflow-hidden flex flex-col h-full">
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-bl-full -mr-16 -mt-16 transition-transform group-hover:scale-150 duration-700"></div>
            <div class="mb-6 inline-flex items-center justify-center w-12 h-12 rounded-full bg-primary/10 text-primary border border-primary/20">
              <span class="material-symbols-outlined">{service.icon}</span>
            </div>
            <h3 class="font-libre-caslon text-headline-md text-on-surface mb-4 group-hover:text-primary transition-colors">
              {service.title}
            </h3>
            <p class="text-body-md text-on-surface-variant flex-grow mb-6">
              {service.description}
            </p>
            <span class="mt-auto font-label-sm text-label-sm uppercase tracking-widest text-primary flex items-center gap-2 group-hover:gap-3 transition-all">
              Explore Service
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Courier Section -->
    <div class="mb-16">
      <h2 class="font-libre-caslon text-headline-lg text-primary mb-8 border-b border-primary/20 pb-4">
        Courier & Logistics
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
        {courierServices.map((service) => (
          <a href="/contact" class="group bg-charcoal-surface border border-white/10 hover:border-primary transition-all duration-500 rounded-lg p-8 relative overflow-hidden flex flex-col h-full">
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-bl-full -mr-16 -mt-16 transition-transform group-hover:scale-150 duration-700"></div>
            <div class="mb-6 inline-flex items-center justify-center w-12 h-12 rounded-full bg-primary/10 text-primary border border-primary/20">
              <span class="material-symbols-outlined">{service.icon}</span>
            </div>
            <h3 class="font-libre-caslon text-headline-md text-on-surface mb-4 group-hover:text-primary transition-colors">
              {service.title}
            </h3>
            <p class="text-body-md text-on-surface-variant flex-grow mb-6">
              {service.description}
            </p>
            <span class="mt-auto font-label-sm text-label-sm uppercase tracking-widest text-primary flex items-center gap-2 group-hover:gap-3 transition-all">
              Explore Service
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Service Support Section -->
  <section class="max-w-container mx-auto px-6 md:px-margin-mobile lg:px-margin-desktop mb-stack-xl">
    <div class="bg-surface-container border border-white/5 rounded-xl p-8 md:p-12 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent"></div>
      <div class="relative z-10 md:flex items-center justify-between gap-12">
        <div class="md:w-2/3 mb-8 md:mb-0">
          <h2 class="font-libre-caslon text-headline-lg text-on-surface mb-4">
            Dedicated Service Support
          </h2>
          <p class="text-body-md text-on-surface-variant">
            We provide dedicated ongoing support throughout the recruitment and travel journey, ensuring every transition is seamless and every requirement is met with precision.
          </p>
        </div>
        <div class="md:w-1/3 flex justify-end">
          <a
            href="/contact"
            class="inline-flex items-center gap-3 bg-transparent border border-white/20 text-on-surface font-label-lg uppercase px-8 py-4 hover:border-primary hover:text-primary transition-all duration-300 rounded"
          >
            <span class="material-symbols-outlined">support_agent</span>
            Contact Support
          </a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

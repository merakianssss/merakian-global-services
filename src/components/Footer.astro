---
const currentYear = new Date().getFullYear();
---

<footer class="bg-rich-black border-t border-white/10 mt-stack-xl">
  <div
    class="max-w-container mx-auto px-6 md:px-margin-mobile lg:px-margin-desktop py-stack-xl"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-stack-lg">
      <!-- Brand Column -->
      <div>
        <a href="/" class="inline-block mb-stack-md" aria-label="Merakian Global Services — Home">
          <span class="font-libre-caslon text-headline-md text-primary">
            Merakian Global
          </span>
        </a>
        <p class="text-body-md text-on-surface-variant mb-stack-md">
          Your Journey, Our Expertise. Premium global services in travel, recruitment, courier, and career consultancy.
        </p>
        <div class="space-y-stack-sm">
          <a
            href="tel:+919819990424"
            class="flex items-center gap-stack-sm text-body-md text-on-surface hover:text-primary transition-colors"
          >
            <span class="material-symbols-outlined text-primary">phone_iphone</span>
            +91 9819990424
          </a>
          <a
            href="mailto:kapil.songara@merakian.net"
            class="flex items-center gap-stack-sm text-body-md text-on-surface hover:text-primary transition-colors"
          >
            <span class="material-symbols-outlined text-primary">mail</span>
            kapil.songara@merakian.net
          </a>
        </div>
      </div>

      <!-- Services Column -->
      <div>
        <h3 class="text-label-lg text-primary uppercase mb-stack-md">
          Services
        </h3>
        <ul class="space-y-stack-sm">
          <li>
            <a href="/services" class="text-body-md text-on-surface hover:text-primary transition-colors">
              All Services
            </a>
          </li>
          <li>
            <a href="/process" class="text-body-md text-on-surface hover:text-primary transition-colors">
              Our Process
            </a>
          </li>
          <li>
            <a href="/recruitment" class="text-body-md text-on-surface hover:text-primary transition-colors">
              Recruitment
            </a>
          </li>
          <li>
            <a href="/contact" class="text-body-md text-on-surface hover:text-primary transition-colors">
              Get a Quote
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal Column -->
      <div>
        <h3 class="text-label-lg text-primary uppercase mb-stack-md">
          Legal
        </h3>
        <ul class="space-y-stack-sm">
          <li>
            <span class="text-body-md text-on-surface-variant" title="Awaiting owner-provided legal copy">
              Privacy Policy
              <span class="block text-label-sm text-primary/70 uppercase tracking-wider mt-1">
                [Owner / Legal Review Required]
              </span>
            </span>
          </li>
          <li>
            <span class="text-body-md text-on-surface-variant" title="Awaiting owner-provided legal copy">
              Terms of Service
              <span class="block text-label-sm text-primary/70 uppercase tracking-wider mt-1">
                [Owner / Legal Review Required]
              </span>
            </span>
          </li>
          <li>
            <span class="text-body-md text-on-surface-variant" title="Awaiting owner-provided legal copy">
              Legal Disclaimers
              <span class="block text-label-sm text-primary/70 uppercase tracking-wider mt-1">
                [Owner / Legal Review Required]
              </span>
            </span>
          </li>
        </ul>
      </div>

      <!-- Connect Column -->
      <div>
        <h3 class="text-label-lg text-primary uppercase mb-stack-md">
          Connect
        </h3>
        <ul class="space-y-stack-sm">
          <li>
            <a
              href="https://www.merakian.net"
              target="_blank"
              rel="noopener noreferrer"
              class="text-body-md text-on-surface hover:text-primary transition-colors"
            >
              www.merakian.net
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/919819990424"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-stack-sm text-body-md text-on-surface hover:text-primary transition-colors"
            >
              <span class="material-symbols-outlined text-primary">chat</span>
              WhatsApp
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-stack-sm text-body-md text-on-surface hover:text-primary transition-colors"
            >
              <span class="material-symbols-outlined text-primary">work</span>
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href="https://www.instagram.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-stack-sm text-body-md text-on-surface hover:text-primary transition-colors"
            >
              <span class="material-symbols-outlined text-primary">photo_camera</span>
              Instagram
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-stack-xl pt-stack-md border-t border-white/10">
      <p class="text-label-sm text-on-surface-variant text-center">
        &copy; {currentYear} Merakian Global Services. All rights reserved.
      </p>
    </div>
  </div>
</footer>

---
const { pathname } = Astro.url;
const isActive = (path: string) => pathname === path;
---

<nav class="hidden md:flex items-center gap-8">
  <a
    href="/"
    class={`text-body-md font-hanken-grotesk hover:text-primary transition-colors ${isActive('/') ? 'text-primary' : 'text-on-surface'}`}
  >
    Home
  </a>
  <a
    href="/services"
    class={`text-body-md font-hanken-grotesk hover:text-primary transition-colors ${isActive('/services') ? 'text-primary' : 'text-on-surface'}`}
  >
    Services
  </a>
  <a
    href="/process"
    class={`text-body-md font-hanken-grotesk hover:text-primary transition-colors ${isActive('/process') ? 'text-primary' : 'text-on-surface'}`}
  >
    Process
  </a>
  <a
    href="/recruitment"
    class={`text-body-md font-hanken-grotesk hover:text-primary transition-colors ${isActive('/recruitment') ? 'text-primary' : 'text-on-surface'}`}
  >
    Recruitment
  </a>
  <a
    href="/contact"
    class={`text-body-md font-hanken-grotesk hover:text-primary transition-colors ${isActive('/contact') ? 'text-primary' : 'text-on-surface'}`}
  >
    Contact
  </a>
</nav>

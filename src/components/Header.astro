---
import DesktopNav from './DesktopNav.astro';
import MobileNav from './MobileNav.astro';
---

<header
  class="sticky top-0 z-40 glass-nav border-b border-primary/20"
>
  <div
    class="max-w-container mx-auto px-6 md:px-margin-mobile lg:px-margin-desktop flex items-center justify-between h-20"
  >
    <a href="/" class="flex items-center gap-3" aria-label="Merakian Global Services — Home">
      <span class="font-libre-caslon text-headline-md text-primary">
        Merakian Global
      </span>
    </a>

    <DesktopNav />

    <div class="hidden md:block">
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-primary to-gold-pressed text-rich-black uppercase label-lg font-hanken-grotesk rounded transition-all hover:btn-primary-glow"
      >
        Request Consultation
      </a>
    </div>

    <MobileNav />
  </div>
</header>
